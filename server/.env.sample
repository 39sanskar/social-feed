# ── Core ────────────────────────────────────────────────────────────────
NODE_ENV=
PORT=
# Public URL of THIS server (used to build links to locally stored uploads)
PUBLIC_URL=
# Frontend origin(s) allowed by CORS and used in e-mail links (comma-separated)
CLIENT_URL=

# ── Database: MongoDB Atlas free M0 cluster ─────────────────────────────
MONGO_URI=

# ── Auth ────────────────────────────────────────────────────────────────
# Generate with: node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"
JWT_SECRET=
# true = users must verify their e-mail before posting / messaging
REQUIRE_VERIFIED_EMAIL=false

# ── Media storage (optional) ────────────────────────────────────────────
# Leave empty to store uploads on local disk (fine for development only).
CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=

# ── E-mail (optional) ───────────────────────────────────────────────────
# Leave empty and verification / reset links are printed to the server console.
RESEND_API_KEY=
MAIL_FROM=Social-Feed <onboarding@resend.dev>

# ── Tuning ──────────────────────────────────────────────────────────────
# A hashtag needs at least this many different authors (24h) to trend
TRENDING_MIN_AUTHORS=2

# docker compose up --build
# docker compose up -d


Quick reference
Action	                                  Command
Build and start	                          docker compose up --build
Start in background	                      docker compose up --build -d
Stop containers	                          docker compose stop
Stop and remove containers	              docker compose down
Start stopped containers	                docker compose start
Restart services	                        docker compose restart
Remove containers and volumes	            docker compose down -v
View logs	                                docker compose logs -f
View status	                              docker compose ps


